{
  "manifestVersion": 2,
  "name": "imgen",
  "displayName": "Imgen 图片适配",
  "publisher": "blackcatcmx",
  "version": "0.3.0",
  "description": "将图片编辑的 multipart 上传转换为 CPR Images JSON 请求",
  "license": "Apache-2.0",
  "engines": { "codex-proxy-rs": ">=3.29.3, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "version": 5,
      "stages": ["request"],
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
